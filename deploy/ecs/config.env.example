# Shared configuration for the ECS deploy scripts. Copy to config.env and edit,
# or export these in your shell before running the scripts.
#
#   cp deploy/ecs/config.env.example deploy/ecs/config.env
#   # edit values, then:  source deploy/ecs/config.env

# --- Required ---
export AWS_REGION="ap-southeast-1"
export AWS_ACCOUNT_ID="123456789012"

# ECR repository name and image tag
export ECR_REPO="career-navigator"
export IMAGE_TAG="latest"

# ECS cluster / service / task family
export ECS_CLUSTER="career-navigator"
export ECS_SERVICE="career-navigator"
export TASK_FAMILY="career-navigator"

# --- Networking (for creating the service; from your VPC) ---
export SUBNET_IDS="subnet-aaaa,subnet-bbbb"          # public subnets (or private + NAT)
export SECURITY_GROUP_ID="sg-xxxxxxxx"               # must allow inbound 8000 from the ALB/your IP
export ASSIGN_PUBLIC_IP="ENABLED"                    # ENABLED for public subnets without a NAT

# --- Secrets ---
# Secrets Manager secret holding the SQLAlchemy URL, e.g.
#   postgresql+psycopg://USER:PASSWORD@<rds-endpoint>:5432/DBNAME
export DATABASE_URL_SECRET_NAME="career-navigator/database-url"
